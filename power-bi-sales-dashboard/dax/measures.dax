// ============================================================
// DAX measures for the Sales Performance Dashboard
// Create these in Power BI Desktop: Modeling > New Measure
// (grouped here by the page they're used on — see docs/build_guide.md)
// ============================================================

// ---------- Core KPIs (used on every page) ----------

Total Revenue =
SUM ( FactSales[LineTotal] )

Total Orders =
DISTINCTCOUNT ( FactSales[InvoiceId] )

Total Customers =
DISTINCTCOUNT ( FactSales[CustomerId] )

Total Units Sold =
SUM ( FactSales[Quantity] )

Average Order Value =
DIVIDE ( [Total Revenue], [Total Orders] )

Average Revenue Per Customer =
DIVIDE ( [Total Revenue], [Total Customers] )

// ---------- Time intelligence (requires DimDate marked as Date Table) ----------

Revenue LY =
CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[Date] ) )

Revenue YoY % =
DIVIDE ( [Total Revenue] - [Revenue LY], [Revenue LY] )

Running Total Revenue =
CALCULATE (
    [Total Revenue],
    FILTER (
        ALLSELECTED ( DimDate[Date] ),
        DimDate[Date] <= MAX ( DimDate[Date] )
    )
)

// ---------- Ranking (used in Top Customers / Top Products tables & tooltips) ----------

Customer Revenue Rank =
RANKX ( ALLSELECTED ( DimCustomer[CustomerName] ), [Total Revenue], , DESC )

Product Revenue Rank =
RANKX ( ALLSELECTED ( DimProduct[TrackName] ), [Total Revenue], , DESC )

// ---------- Segmentation (Customer Analysis page) ----------

Orders Per Customer =
DIVIDE ( [Total Orders], [Total Customers] )

// Repeat vs. one-time customers — evaluate at customer grain, then aggregate.
// Use as the base measure for a calculated column/table or a "Customer Segment" field
// created with SWITCH(TRUE(), [Orders Per Customer (this customer)] > 1, "Repeat", "One-time")
Is Repeat Customer =
VAR OrdersForCustomer =
    CALCULATE ( [Total Orders], ALLEXCEPT ( FactSales, DimCustomer[CustomerId] ) )
RETURN
    IF ( OrdersForCustomer > 1, "Repeat customer", "One-time customer" )
